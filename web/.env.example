# Create web/.env.local and paste a TMDB API Read Access Token.
# It is used only by server route handlers and is never sent to the browser.
TMDB_READ_ACCESS_TOKEN=paste_your_personal_read_access_token_here

# Supabase's Vercel integration provides these two browser-safe values.
# Row Level Security in supabase/migrations keeps each user's library private.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=paste_your_publishable_key_here
